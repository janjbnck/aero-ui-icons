{
  "name": "aero-ui-icons",
  "version": "1.0.0",
  "description": "SVG icons in the style of the Windows 7 Aero interface",
  "keywords": [
    "icons",
    "svg",
    "aero",
    "windows-7"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janjbnck/aero-ui-icons.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*.svg": "./icons/*.svg"
  },
  "files": [
    "dist",
    "icons"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "prepublishOnly": "npm run build"
  }
}
